# M5Stack Tab5: ESP32-P4 rev v1.0 or later (flash at 80 MHz needs it), 16 MB flash, 32 MB PSRAM
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# No heap in LP RAM: blocks that land there once internal RAM runs out (glyph pages, row groups) draw and build slower
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
# The example's per-frame numbers live in PSRAM (EXT_RAM_BSS_ATTR)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Heap, libc lock, I2C and PARLIO interrupt code that need not run with the cache off stays in flash: 11.2 KiB more
# internal RAM (IDF 6.1). The *_IN_IRAM options for libc, log, esp_timer, ROM print, regi2c and RTC clock/time can only
# be turned off with CONFIG_SPI_FLASH_AUTO_SUSPEND (8.4 KiB more), which IDF's flash driver allows for the Tab5's XMC
# flash (0x464018), but such an app did not start on a P4 v1.0 Tab5.
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_PARLIO_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_PARLIO_RX_ISR_HANDLER_IN_IRAM=n
